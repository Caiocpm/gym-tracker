PORT=3000
NODE_ENV=development

# ─── Banco de dados ───────────────────────────────────────────────────────────
# Instale o PostgreSQL localmente ou use um serviço gratuito como Neon.tech
DATABASE_URL=postgresql://user:password@localhost:5432/gymtracker

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Crie em: console.cloud.google.com > APIs & Services > Credentials > OAuth 2.0 Client ID
# Tipo: Web application | Origens JS autorizadas: http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Separe múltiplas origens por vírgula
ALLOWED_ORIGINS=http://localhost:5173
